ASMAI_APP_NAME=ASMAI Backend
ASMAI_ENVIRONMENT=local
ASMAI_LOG_LEVEL=INFO
ASMAI_API_V1_PREFIX=/api/v1
ASMAI_DATA_DIR=data
ASMAI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ASMAI_EMBEDDING_BATCH_SIZE=16
ASMAI_CHAT_TOP_K=3
ASMAI_CHAT_MAX_EXCERPT_CHARS=700

# Public Notion source (no API token required)
ASMAI_NOTION_PUBLIC_PAGE_URL=https://est-tech.notion.site/EST-SECURITY-386fe935d7a78059aecafce8bc5c430b
